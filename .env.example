# Neon Postgres
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# TEMPORARY development auth bypass — REMOVE BEFORE LAUNCH.
# When "true", Clerk is skipped entirely and every request runs as a fixed
# local user (dev_local_user). Lets you run the app with no working Clerk
# credentials. Ignored in production builds — see src/lib/auth-mode.ts.
AUTH_DISABLED=false

# LLM feedback
OPENROUTER_API_KEY=sk-or-v1-...
ANTHROPIC_API_KEY=

# Inference — keep mock until Modal is deployed (see inference/README.md)
INFERENCE_MODE=mock
# INFERENCE_MODE=modal
INFERENCE_URL=
# INFERENCE_URL=https://<workspace>--golf-ai-inference-inferenceservice-fastapi.modal.run
INFERENCE_SHARED_SECRET=replace-with-long-random-string
SWINGNET_CHECKPOINT_URL=
# Optional smoke-test clip (≥120fps preferred)
SMOKE_VIDEO_URL=

# Stripe test mode (Phase E)
STRIPE_SECRET_KEY=sk_test_...

# Closed coach-review study (not golfer accounts, not uploaded customer clips).
# Coaches open /review with an access code and label the sample at COACH_REVIEW_SAMPLE_URL.
# The board is /review/board. AUTH_DISABLED unlocks it locally; in production set the secret.
COACH_REVIEW_SECRET=
COACH_REVIEW_SAMPLE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
