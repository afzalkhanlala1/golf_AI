# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# GolfDB / evaluation data — never commit datasets
/data/

# Inference local venv / caches
/inference/.venv/
/inference/__pycache__/
/inference/**/__pycache__/
*.pyc

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Local deploy packing artifacts
/_mcp_args*.json
/_deploy_*.json
/deploy-files.json
/.deploy-args-temp.json

# Local large / duplicate docs
Golf-AI-Build-Plan.pdf
SPEC.md.txt

.vercel
.env*

# Local test clips — do not commit video into the repo
Test vedio *.mp4
*.mp4

# Pose model weights — downloaded at image build / on demand, never committed
inference/models/
*.task
